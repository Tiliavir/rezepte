{
  "name": "rezepte",
  "version": "2026.11.14",
  "private": true,
  "description": "Die Gute-Sachen Liste – unsere Rezeptsammlung",
  "license": "MIT",
  "author": "tiliavir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiliavir/rezepte.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "hugo server",
    "lint": "biome check . && tsc -p tsconfig.typecheck.json",
    "build": "hugo --minify && node csp-hashes.mjs public && npm run index && node validate.mjs",
    "index": "mvw-search-index 'recipes/*/index.html' public/suche.json main --cwd public --language de --strip-index-html --exclude 'nav, footer, .recipe-actions, .related, .scaler'",
    "format": "biome check --write ."
  },
  "dependencies": {
    "lunr": "2.3.9",
    "lunr-languages": "1.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/lunr": "2.3.7",
    "mvw-search-index": "3.0.3",
    "typescript": "7.0.2",
    "vnu-jar": "26.11.9"
  }
}
